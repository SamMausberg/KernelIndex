{
  "name": "@kernelindex/mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only MCP server over the public KernelIndex REST API. Stdio transport: npx -y @kernelindex/mcp",
  "license": "Apache-2.0",
  "homepage": "https://kernelindex.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamMausberg/KernelIndex.git",
    "directory": "apps/mcp"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "kernelindex-mcp": "./src/server.ts"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "kernelindex-mcp": "./dist/server.js"
    },
    "exports": {
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@kernelindex/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.13.3",
    "vitest": "^4.1.10"
  },
  "exports": {
    "./server": "./src/server.ts"
  }
}
