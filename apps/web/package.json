{
  "name": "@kernelindex/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "schemas:generate": "node scripts/generate-schemas.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "db:sync-records": "node --env-file-if-exists=.env.local scripts/sync-record-events.ts",
    "import:sol": "node --env-file-if-exists=.env.local scripts/import-sol.ts",
    "import:gpumode": "node --env-file-if-exists=.env.local scripts/import-gpumode.ts",
    "test:e2e": "playwright test",
    "export:catalog": "node --env-file-if-exists=.env.local scripts/export-catalog.ts",
    "import:submission": "node --env-file-if-exists=.env.local scripts/import-submission.ts",
    "import:flashinfer": "node --env-file-if-exists=.env.local scripts/import-flashinfer.ts",
    "check:invariants": "node --env-file-if-exists=.env.local scripts/check-invariants.ts",
    "report:health": "node --env-file-if-exists=.env.local scripts/report-health.ts",
    "openapi:generate": "node scripts/generate-openapi.ts",
    "import:mlperf": "node --env-file-if-exists=.env.local scripts/import-mlperf.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.0",
    "better-auth": "^1.6.29",
    "canonicalize": "4.0.0",
    "clsx": "2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.2",
    "next": "16.2.12",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3",
    "spdx-expression-parse": "5.0.0",
    "spdx-license-list": "6.12.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mongodb-js/zstd": "^7.0.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
