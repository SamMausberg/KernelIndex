# Copy to .env.local for local development. Values here match compose.yaml
# and are local-development defaults only — never reuse them elsewhere.
#
# fixtures (default): deterministic illustrative catalog, no database needed.
# postgres: real catalog reads; requires DATABASE_URL.
CATALOG_BACKEND=fixtures

# Pooled URL for web requests; direct URL for migrations (§27.9).
DATABASE_URL=postgres://kernelindex:kernelindex@127.0.0.1:5432/kernelindex
DATABASE_DIRECT_URL=postgres://kernelindex:kernelindex@127.0.0.1:5432/kernelindex

# Pinned nvidia/sol-execbench commit for import:sol --snapshot solutions (40-hex).
# Unpinned solutions are skipped for review (design doc 22.15 gold record).
SOL_EXAMPLES_COMMIT=

# Identity (design 13.6): GitHub OAuth app; unset keeps the site read-only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET=
# Canonical Better Auth origin (http://localhost:3000 for local OAuth).
SITE_ORIGIN=
# Bearer token for POST /api/v1/revalidate (importers call it after publish).
REVALIDATE_TOKEN=
